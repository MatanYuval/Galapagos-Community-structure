"""
benthicFriend for Agisoft Metashape
===================================

USER INSTRUCTIONS

1. Open a Metashape project, select the chunk containing the 3D model, and
   position the reconstruction region around the area you want to sample.
2. In Metashape, choose Tools > Run Script... and select this Python file.
   The script adds a new "benthicFriend" menu containing two commands:
   - Sample points...
     Creates Poisson-distributed markers on the alpha-shape surface.
     Enter the required number of points when prompted. The suggested number
     is based on the original Metashape mesh area. New markers are labelled
     PT_1, PT_2, and so on.

   - Export marker images...
     First choose the output folder. Then select:
       1 = best real camera image only (default)
       2 = combined best-camera and synthetic-model image pair
     Finally select:
       0 = no red marker (default)
       1 = add a red marker

   The selected folder receives the images and results_df.txt.

NOTES

- Image export processes markers whose labels begin with "PT".
- No external coordinate reference system is required.
- Missing NumPy, Open3D, pandas, and OpenCV packages are installed
  automatically. Internet access is required only when installation is needed.
- Main settings can be changed below: ALPHA, POINTS_PER_UNIT_AREA, CROP_SIZE,
  VIEW_MAGNIFICATION, and MARKER_PREFIX.
"""

import importlib
import importlib.util
import math
import os
import re
import site
import subprocess
import sys
import tempfile

import Metashape


REQUIRED_PACKAGES = {
    "numpy": "numpy",
    "open3d": "open3d",
    "pandas": "pandas",
    "cv2": "opencv-python",
}


def install_missing_packages():
    missing_packages = [
        pip_name
        for import_name, pip_name in REQUIRED_PACKAGES.items()
        if importlib.util.find_spec(import_name) is None
    ]

    if not missing_packages:
        return

    print(
        "Installing missing benthicFriend packages: "
        + ", ".join(missing_packages)
    )

    command = [sys.executable, "-m", "pip", "install"]
    if site.ENABLE_USER_SITE:
        command.append("--user")
    command.extend(missing_packages)

    try:
        subprocess.check_call(command)
    except Exception as error:
        Metashape.app.messageBox(
            "Could not install the required Python packages:\n\n"
            + ", ".join(missing_packages)
            + f"\n\n{error}"
        )
        raise

    if site.ENABLE_USER_SITE:
        user_site = site.getusersitepackages()
        if user_site not in sys.path:
            sys.path.append(user_site)

    importlib.invalidate_caches()
    print("Required packages installed successfully.")


install_missing_packages()

import cv2
import numpy as np
import open3d as o3d
import pandas as pd


ALPHA = 0.05
POINTS_PER_UNIT_AREA = 10
CROP_SIZE = 1600
VIEW_MAGNIFICATION = 1000
MARKER_PREFIX = "PT"

SAMPLE_MENU_PATH = "benthicFriend/Sample points..."
EXPORT_MENU_PATH = "benthicFriend/Export marker images..."

RESULT_COLUMNS = [
    "Marker Label",
    "Camera Index",
    "Camera Label",
    "Projected 2D Coordinates",
    "marker_position_chunk_coords",
]


def sample_benthic_points():
    """Create Poisson-distributed markers on the model surface."""

    try:
        chunk = Metashape.app.document.chunk

        if chunk is None or chunk.model is None:
            raise RuntimeError("The active chunk has no 3D model.")

        T = chunk.transform.matrix
        origin = T.mulp(Metashape.Vector([0, 0, 0]))

        local_frame = (
            chunk.crs.localframe(origin)
            if chunk.crs
            else Metashape.Matrix().Diag([1, 1, 1, 1])
        )

        m = local_frame * T
        scale = math.sqrt(sum(m[0, i] ** 2 for i in range(3)))

        if scale == 0:
            raise RuntimeError("The chunk transformation has zero scale.")

        rotation = Metashape.Matrix([
            [m[row, column] / scale for column in range(3)]
            for row in range(3)
        ])

        region = chunk.region
        region.rot = rotation.t()
        chunk.region = region

        center = T.mulp(region.center)
        half_size = chunk.transform.scale * region.size / 2

        min_bounds = np.asarray(center - half_size)
        max_bounds = np.asarray(center + half_size)

        vertices = []

        for vertex in chunk.model.vertices:
            position = np.asarray(
                T.mulp(vertex.coord[:3])[:3]
            )

            if np.all(
                (position >= min_bounds)
                & (position <= max_bounds)
            ):
                vertices.append(position)

        if len(vertices) < 4:
            raise RuntimeError(
                "Not enough model vertices were found inside the region."
            )

        vertices = np.asarray(vertices, dtype=np.float64)

        point_cloud = o3d.geometry.PointCloud()
        point_cloud.points = o3d.utility.Vector3dVector(vertices)

        mesh = o3d.geometry.TriangleMesh.create_from_point_cloud_alpha_shape(
            point_cloud,
            ALPHA
        )

        if len(mesh.triangles) == 0:
            raise RuntimeError(
                "The alpha-shape mesh is empty. "
                "Try changing the ALPHA value."
            )

        # Density is based on the original Metashape mesh. The alpha-shape
        # mesh is used only as the surface from which points are sampled.
        surface_area = chunk.model.area()

        suggested_points = max(
            1,
            round(surface_area * POINTS_PER_UNIT_AREA)
        )

        print(f"Original mesh surface area: {surface_area:.3f}")
        print(
            f"Suggested points: {suggested_points} "
            f"({POINTS_PER_UNIT_AREA} points per unit²)"
        )

        number_of_points = Metashape.app.getInt(
            (
                f"Original mesh surface area: {surface_area:.2f} unit²\n"
                f"Suggested density: {POINTS_PER_UNIT_AREA} points/unit²\n"
                "Number of points to sample:"
            ),
            suggested_points
        )

        if number_of_points is None:
            return

        if number_of_points < 1:
            raise ValueError(
                "The number of points must be greater than zero."
            )

        sampled_cloud = mesh.sample_points_poisson_disk(
            number_of_points=number_of_points,
            init_factor=5
        )

        for index, point in enumerate(
            sampled_cloud.points,
            start=1
        ):
            marker = chunk.addMarker()
            marker.reference.location = Metashape.Vector(point)
            marker.label = f"PT_{index}"

            if index % 500 == 0:
                print(
                    f"Created {index}/{number_of_points} markers"
                )

        Metashape.app.update()

        Metashape.app.messageBox(
            f"Original mesh surface area: {surface_area:.2f} unit²\n"
            f"Created {number_of_points} sampling points."
        )

    except Exception as error:
        Metashape.app.messageBox(
            f"Could not create sampling points:\n\n{error}"
        )
        raise


def vector_magnitude(vector):
    return math.sqrt(sum(vector[i] ** 2 for i in range(3)))


def safe_filename(value):
    """Replace characters that are not safe in Windows filenames."""
    return re.sub(r'[<>:"/\\|?*]+', "_", str(value)).strip(" .")


def find_best_camera(chunk, marker):
    """Return the real camera whose projected ray lands closest to the marker."""
    candidates = []

    for camera_index, camera in enumerate(chunk.cameras):
        if camera.transform is None:
            continue

        projected = camera.project(marker.position)
        if projected is None:
            continue

        x, y = projected
        if not (
            camera.sensor.width / 8 <= x < camera.sensor.width * 7 / 8
            and camera.sensor.height / 8 <= y < camera.sensor.height * 7 / 8
        ):
            continue

        surface_point = chunk.model.pickPoint(
            camera.center,
            camera.unproject(projected),
        )
        if surface_point is None:
            continue

        # No external CRS is required because both values use the same
        # internal chunk coordinate system.
        error = vector_magnitude(surface_point - marker.position)
        candidates.append((error, camera_index, camera, projected))

    if not candidates:
        return None

    return min(candidates, key=lambda item: item[0])


def orient_projected_point(camera, x, y):
    """Convert sensor coordinates to the orientation of the image file."""
    if camera.orientation == 6:  # 90 degrees clockwise
        return int(camera.sensor.height - y), int(x)
    if camera.orientation == 8:  # 270 degrees clockwise
        return int(y), int(camera.sensor.width - x)
    if camera.orientation == 3:  # 180 degrees
        return int(camera.sensor.width - x), int(camera.sensor.height - y)
    return int(x), int(y)


def crop_camera_image(camera, projected):
    image = cv2.imread(camera.photo.path)
    if image is None:
        raise RuntimeError(f"Could not load camera image: {camera.photo.path}")

    point_x, point_y = orient_projected_point(
        camera,
        projected[0],
        projected[1],
    )

    x_start = max(0, point_x - CROP_SIZE // 2)
    y_start = max(0, point_y - CROP_SIZE // 2)
    x_end = min(image.shape[1], point_x + CROP_SIZE // 2)
    y_end = min(image.shape[0], point_y + CROP_SIZE // 2)

    cropped = image[y_start:y_end, x_start:x_end].copy()
    crop_point = (point_x - x_start, point_y - y_start)
    return cropped, crop_point, (point_x, point_y)


def capture_synthetic_view(chunk, marker, output_folder):
    """Capture the Metashape model view centred on a marker."""
    if marker.reference.location is not None:
        view_center = marker.reference.location
    else:
        view_center = chunk.transform.matrix.mulp(marker.position)

    Metashape.app.model_view.viewpoint.coo = view_center
    Metashape.app.model_view.viewpoint.mag = VIEW_MAGNIFICATION
    Metashape.app.update()

    rendered = Metashape.app.model_view.captureView(
        CROP_SIZE,
        CROP_SIZE,
        False,
        True,
    )

    descriptor, temporary_path = tempfile.mkstemp(
        prefix="benthicFriend_render_",
        suffix=".png",
        dir=output_folder,
    )
    os.close(descriptor)
    os.remove(temporary_path)

    try:
        rendered.save(temporary_path)
        image = cv2.imread(temporary_path)
        if image is None:
            raise RuntimeError("Could not read the captured synthetic view.")
        return image
    finally:
        if os.path.exists(temporary_path):
            os.remove(temporary_path)


def add_red_mark(image, point, filled=False):
    thickness = -1 if filled else 5
    cv2.circle(
        image,
        (int(point[0]), int(point[1])),
        radius=10,
        color=(0, 0, 255),
        thickness=thickness,
    )


def export_marker_images():
    """Export a table and either one real image or a real/synthetic pair."""
    try:
        output_folder = Metashape.app.getExistingDirectory(
            "Choose the output folder"
        )
        if not output_folder:
            return

        image_mode = Metashape.app.getInt(
            "Image output:\n"
            "1 = best real camera only (default)\n"
            "2 = best real camera + synthetic model view",
            1,
        )
        if image_mode is None:
            return
        if image_mode not in (1, 2):
            raise ValueError("Image output must be 1 or 2.")

        red_mark_choice = Metashape.app.getInt(
            "Add a red mark?\n"
            "0 = no (default)\n"
            "1 = yes",
            0,
        )
        if red_mark_choice is None:
            return
        if red_mark_choice not in (0, 1):
            raise ValueError("Red-mark choice must be 0 or 1.")
        add_mark = red_mark_choice == 1

        chunk = Metashape.app.document.chunk
        if chunk is None or chunk.model is None:
            raise RuntimeError("The active chunk has no 3D model.")

        markers = [
            marker
            for marker in chunk.markers
            if marker.label.startswith(MARKER_PREFIX)
            and marker.position is not None
        ]
        if not markers:
            raise RuntimeError(
                f'No markers beginning with "{MARKER_PREFIX}" were found.'
            )

        os.makedirs(output_folder, exist_ok=True)

        document_path = Metashape.app.document.path
        project_name = (
            os.path.splitext(os.path.basename(document_path))[0]
            if document_path
            else "MetashapeProject"
        )
        combined_name = f"{project_name}_{chunk.label}"

        results = []
        exported_count = 0

        for marker in markers:
            best = find_best_camera(chunk, marker)
            if best is None:
                print(f"No suitable camera found for {marker.label}; skipped.")
                continue

            _error, camera_index, camera, projected = best

            try:
                real_image, real_point, oriented_point = crop_camera_image(
                    camera,
                    projected,
                )

                if add_mark:
                    add_red_mark(real_image, real_point)

                marker_name = safe_filename(marker.label)
                camera_label = safe_filename(camera.label)
                project_label = safe_filename(project_name)

                if image_mode == 1:
                    output_name = (
                        f"{marker_name}_{camera_label}_"
                        f"x{oriented_point[0]}_y{oriented_point[1]}_"
                        f"{project_label}.png"
                    )
                    output_image = real_image
                else:
                    synthetic_image = capture_synthetic_view(
                        chunk,
                        marker,
                        output_folder,
                    )
                    if add_mark:
                        synthetic_center = (
                            synthetic_image.shape[1] // 2,
                            synthetic_image.shape[0] // 2,
                        )
                        add_red_mark(
                            synthetic_image,
                            synthetic_center,
                            filled=True,
                        )

                    if real_image.shape[0] != synthetic_image.shape[0]:
                        new_width = round(
                            synthetic_image.shape[1]
                            * real_image.shape[0]
                            / synthetic_image.shape[0]
                        )
                        synthetic_image = cv2.resize(
                            synthetic_image,
                            (new_width, real_image.shape[0]),
                        )

                    separator = np.zeros(
                        (real_image.shape[0], 5, 3),
                        dtype=np.uint8,
                    )
                    output_image = np.hstack(
                        (real_image, separator, synthetic_image)
                    )

                    pair_height = round(
                        output_image.shape[0]
                        * CROP_SIZE
                        / output_image.shape[1]
                    )
                    output_image = cv2.resize(
                        output_image,
                        (CROP_SIZE, pair_height),
                    )
                    output_name = (
                        f"{marker_name}_{camera_label}_"
                        f"{safe_filename(combined_name)}_pair.png"
                    )

                output_path = os.path.join(output_folder, output_name)
                if not cv2.imwrite(output_path, output_image):
                    raise RuntimeError(f"Could not save image: {output_path}")

                transformed_position = chunk.transform.matrix.mulp(
                    marker.position
                )
                results.append({
                    "Marker Label": marker.label,
                    "Camera Index": camera_index,
                    "Camera Label": camera.label,
                    "Projected 2D Coordinates": (
                        int(projected[0]),
                        int(projected[1]),
                    ),
                    "marker_position_chunk_coords": transformed_position,
                })
                exported_count += 1

            except Exception as marker_error:
                print(f"Could not export {marker.label}: {marker_error}")

        results_df = pd.DataFrame(results, columns=RESULT_COLUMNS)
        dataframe_path = os.path.join(output_folder, "results_df.txt")
        results_df.to_csv(dataframe_path, index=False, header=True)

        Metashape.app.messageBox(
            f"Export complete.\n\n"
            f"Images created: {exported_count}\n"
            f"DataFrame: {dataframe_path}"
        )

    except Exception as error:
        Metashape.app.messageBox(
            f"Could not export marker images:\n\n{error}"
        )
        raise


def register_menu():
    legacy_paths = (
        "benthiFriend/Sample points...",
        "benthiFriend/Export marker images...",
    )

    for menu_path in (
        SAMPLE_MENU_PATH,
        EXPORT_MENU_PATH,
        *legacy_paths,
    ):
        try:
            Metashape.app.removeMenuItem(menu_path)
        except Exception:
            pass

    Metashape.app.addMenuItem(
        SAMPLE_MENU_PATH,
        sample_benthic_points,
    )
    Metashape.app.addMenuItem(
        EXPORT_MENU_PATH,
        export_marker_images,
    )

    print(f"Menu registered: {SAMPLE_MENU_PATH}")
    print(f"Menu registered: {EXPORT_MENU_PATH}")


register_menu()
