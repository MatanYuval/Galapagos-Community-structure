def install_missing_packages():
    """Automatically install missing dependencies without prompting the user."""
    missing_packages = [
        pip_name
        for import_name, pip_name in REQUIRED_PACKAGES.items()
        if importlib.util.find_spec(import_name) is None
    ]

    if not missing_packages:
        return

    # Make sure pip exists in Metashape's Python environment.
    try:
        subprocess.check_call(
            [sys.executable, "-m", "pip", "--version"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL
        )
    except Exception:
        subprocess.check_call(
            [sys.executable, "-m", "ensurepip", "--upgrade"]
        )

    command = [
        sys.executable,
        "-m",
        "pip",
        "install",
        "--disable-pip-version-check",
        "--no-input"
    ]

    if site.ENABLE_USER_SITE:
        command.append("--user")

    command.extend(missing_packages)

    print(
        "Installing missing benthicFriend packages: "
        + ", ".join(missing_packages)
    )

    subprocess.check_call(command)

    if site.ENABLE_USER_SITE:
        user_site = site.getusersitepackages()
        if user_site not in sys.path:
            sys.path.append(user_site)

    importlib.invalidate_caches()


install_missing_packages()

import cv2
import numpy as np
import open3d as o3d
import pandas as pd
from sklearn.neighbors import KDTree


ALPHA = 0.05
POINTS_PER_UNIT_AREA = 10
DEFAULT_CROP_SIZE = 1600
VIEW_MAGNIFICATION = 1000
TOP_VIEW_ZOOM_OUT = 1.75
MARKER_PREFIX = "PT"

SAMPLE_MENU_PATH = "benthicFriend/Sample points..."
EXPORT_MENU_PATH = "benthicFriend/Export marker images..."


def vector_magnitude(vec):
    return (vec[0] ** 2 + vec[1] ** 2 + vec[2] ** 2) ** 0.5


def safe_filename(value):
    return re.sub(r'[<>:"/\\|?*]+', "_", str(value)).strip(" .")


def sample_benthic_points():
    """
    1. Read original Metashape mesh vertices in world coordinates.
    2. Build alpha-shape surface.
    3. Poisson-sample the alpha shape.
    4. KD-tree finds nearest ORIGINAL mesh vertex index.
    5. Convert that selected world vertex back to internal coordinates.
    6. Add the marker on the model with chunk.addMarker(point_internal).
    7. Preserve the exact world coordinate in marker.reference.location.
    """
    chunk = Metashape.app.document.chunk

    if chunk is None or chunk.model is None:
        raise RuntimeError("The active chunk has no 3D model.")

    T = chunk.transform.matrix

    origin = T.mulp(Metashape.Vector([0, 0, 0]))

    if chunk.crs:
        m = chunk.crs.localframe(origin)
    else:
        m = Metashape.Matrix().Diag([1, 1, 1, 1])

    m = m * T

    scale = math.sqrt(
        m[0, 0] ** 2 +
        m[0, 1] ** 2 +
        m[0, 2] ** 2
    )

    R = Metashape.Matrix([
        [m[0, 0], m[0, 1], m[0, 2]],
        [m[1, 0], m[1, 1], m[1, 2]],
        [m[2, 0], m[2, 1], m[2, 2]]
    ]) * (1.0 / scale)

    region = chunk.region
    region.rot = R.t()
    chunk.region = region

    center = T.mulp(region.center)
    half_size = chunk.transform.scale * region.size / 2

    min_bounds = np.asarray(center - half_size)
    max_bounds = np.asarray(center + half_size)

    vertices = []

    for vertex in chunk.model.vertices:
        position = np.asarray(
            T.mulp(vertex.coord[:3])[:3],
            dtype=np.float64
        )

        if np.all(
            (position >= min_bounds) &
            (position <= max_bounds)
        ):
            vertices.append(position)

    if len(vertices) < 4:
        raise RuntimeError(
            "Not enough model vertices were found inside the region."
        )

    vertices = np.asarray(vertices, dtype=np.float64)

    point_cloud = o3d.geometry.PointCloud()
    point_cloud.points = o3d.utility.Vector3dVector(vertices)

    mesh = o3d.geometry.TriangleMesh.create_from_point_cloud_alpha_shape(
        point_cloud,
        ALPHA
    )

    if len(mesh.triangles) == 0:
        raise RuntimeError(
            "The alpha-shape mesh is empty. Try changing ALPHA."
        )

    # Metashape mesh area is already scaled.
    surface_area = chunk.model.area()

    suggested_points = max(
        1,
        round(surface_area * POINTS_PER_UNIT_AREA)
    )

    number_of_points = Metashape.app.getInt(
        (
            f"Metashape mesh surface area: {surface_area:.2f} unit²\n"
            f"Suggested density: {POINTS_PER_UNIT_AREA} points/unit²\n"
            "Number of points to sample:"
        ),
        suggested_points
    )

    if number_of_points is None:
        return

    sampled_points = mesh.sample_points_poisson_disk(
        number_of_points=number_of_points,
        init_factor=5
    )

    sampled_points = np.asarray(
        sampled_points.points,
        dtype=np.float64
    )

    tree = KDTree(vertices)
    _, nearest_indices = tree.query(sampled_points, k=1)
    nearest_indices = nearest_indices[:, 0]

    for index, vertex_index in enumerate(nearest_indices, start=1):
        point_world = Metashape.Vector(
            vertices[vertex_index].tolist()
        )

        point_internal = T.inv().mulp(point_world)

        marker = chunk.addMarker(point_internal)
        marker.reference.location = point_world
        marker.label = f"PTxt{index}"

        if index % 500 == 0:
            print(f"Created {index}/{number_of_points} markers")

    Metashape.app.update()

    Metashape.app.messageBox(
        f"Created {number_of_points} sampling points."
    )



def metashape_image_to_cv2(image, output_folder, prefix):
    """Temporarily save a Metashape.Image and read it with OpenCV."""
    descriptor, path = tempfile.mkstemp(
        prefix=prefix,
        suffix=".png",
        dir=output_folder
    )

    os.close(descriptor)
    os.remove(path)

    try:
        image.save(path)
        image_np = cv2.imread(path)

        if image_np is None:
            raise RuntimeError(
                "Could not read rendered synthetic image."
            )

        return image_np

    finally:
        if os.path.exists(path):
            os.remove(path)


def orient_image_like_photo(image, camera):
    """Apply the same orientation cases used for the real photo."""
    if camera.orientation == 6:
        return cv2.rotate(
            image,
            cv2.ROTATE_90_CLOCKWISE
        )

    if camera.orientation == 8:
        return cv2.rotate(
            image,
            cv2.ROTATE_90_COUNTERCLOCKWISE
        )

    if camera.orientation == 3:
        return cv2.rotate(
            image,
            cv2.ROTATE_180
        )

    return image


def crop_around_point(image, x, y, crop_size):
    """Crop `crop_size` pixels around a point."""
    x = int(x)
    y = int(y)

    x_start = max(
        0,
        x - crop_size // 2
    )

    y_start = max(
        0,
        y - crop_size // 2
    )

    x_end = min(
        image.shape[1],
        x + crop_size // 2
    )

    y_end = min(
        image.shape[0],
        y + crop_size // 2
    )

    cropped = image[
        y_start:y_end,
        x_start:x_end
    ].copy()

    point_in_crop = (
        x - x_start,
        y - y_start
    )

    return cropped, point_in_crop



def get_chunk_rotation(chunk):
    """
    Return the chunk rotation matrix.

    Some Metashape chunks have a valid chunk.transform.matrix but
    chunk.transform.rotation is None. In that case derive the rotation
    from the scaled 3x3 part of the transformation matrix.
    """
    rotation = chunk.transform.rotation

    if rotation is not None:
        return rotation

    T = chunk.transform.matrix

    scale = math.sqrt(
        T[0, 0] ** 2 +
        T[0, 1] ** 2 +
        T[0, 2] ** 2
    )

    if scale == 0:
        raise RuntimeError(
            "Chunk transformation has zero scale."
        )

    return Metashape.Matrix([
        [T[0, 0] / scale, T[0, 1] / scale, T[0, 2] / scale],
        [T[1, 0] / scale, T[1, 1] / scale, T[1, 2] / scale],
        [T[2, 0] / scale, T[2, 1] / scale, T[2, 2] / scale],
    ])


def render_standardized_top_view(
    chunk,
    marker,
    crop_size,
    output_folder
):
    """
    Render a standardized top-down synthetic view centred on the marker.

    This follows the user's earlier Metashape renderImage approach:
    virtual camera above the marker, fixed top-down orientation,
    square calibration.
    """
    target_marker = marker.position

    if target_marker is None:
        raise RuntimeError(
            f"{marker.label} has no internal 3D position."
        )

    region = chunk.region

    # Put the virtual camera above the marker along the region Z axis.
    height = max(
        0.1 * region.size.z * TOP_VIEW_ZOOM_OUT,
        1e-6
    )

    location = (
        target_marker
        + region.rot
        * Metashape.Vector([0, 0, height])
    )

    chunk_rotation = get_chunk_rotation(chunk)

    R = (
        chunk_rotation.t()
        * Metashape.Matrix().Diag([1, -1, -1])
    )

    cameraT = (
        Metashape.Matrix().Translation(location)
        * Metashape.Matrix().Rotation(R)
    )

    calibration = Metashape.Calibration()
    calibration.width = crop_size
    calibration.height = crop_size
    calibration.f = crop_size // 2

    rendered = chunk.model.renderImage(
        cameraT,
        calibration
    )

    return metashape_image_to_cv2(
        rendered,
        output_folder,
        "benthicFriend_top_"
    )


def render_selected_camera_view(
    chunk,
    camera,
    old_x,
    old_y,
    new_x,
    new_y,
    crop_size,
    output_folder
):
    """
    Render the model from the selected real camera using the same aligned
    camera transform and calibration, then apply the same orientation
    correction and crop around the same projected marker location.
    """
    rendered = chunk.model.renderImage(
        camera.transform,
        camera.sensor.calibration
    )

    image_np = metashape_image_to_cv2(
        rendered,
        output_folder,
        "benthicFriend_camera_"
    )

    image_np = orient_image_like_photo(
        image_np,
        camera
    )

    synthetic_crop, synthetic_point = crop_around_point(
        image_np,
        new_x,
        new_y,
        crop_size
    )

    return synthetic_crop, synthetic_point


def export_marker_images():
    """
    Export logic kept as close as possible to the user's original code.

    Intentional additions only:
    - choose output folder
    - choose crop size
    - choose red mark yes/no
    - choose synthetic image yes/no
    - explicit orientation 3 handling
    """

    chunk = Metashape.app.document.chunk

    if chunk is None or chunk.model is None:
        raise RuntimeError("The active chunk has no 3D model.")

    output_root = Metashape.app.getExistingDirectory(
        "Choose the output folder"
    )
    if not output_root:
        return

    crop_size = Metashape.app.getInt(
        "Image crop size in pixels around the point:",
        DEFAULT_CROP_SIZE
    )
    if crop_size is None:
        return

    red_mark_choice = Metashape.app.getInt(
        "Add red mark?\n0 = no\n1 = yes",
        1
    )
    if red_mark_choice is None:
        return
    add_red_mark = red_mark_choice == 1

    synthetic_choice = Metashape.app.getInt(
        "Export synthetic 3D model image?\n"
        "0 = no\n"
        "1 = yes",
        1
    )
    if synthetic_choice is None:
        return
    export_synthetic = synthetic_choice == 1

    synthetic_view_mode = None

    if export_synthetic:
        synthetic_view_mode = Metashape.app.getInt(
            "Synthetic view:\n"
            "1 = standardized top view\n"
            "2 = match selected camera",
            1
        )

        if synthetic_view_mode is None:
            return

        if synthetic_view_mode not in (1, 2):
            raise ValueError(
                "Synthetic view must be 1 or 2."
            )

    doc_path = Metashape.app.document.path
    chunk_label = chunk.label
    project_name = (
        os.path.splitext(os.path.basename(doc_path))[0]
        if doc_path
        else "MetashapeProject"
    )

    combined_name = f"{project_name}_{chunk_label}"

    output_folder = os.path.join(
        output_root,
        safe_filename(combined_name)
    )
    os.makedirs(output_folder, exist_ok=True)

    results = []

    pt_markers = [
        marker
        for marker in chunk.markers
        if marker.label.startswith(MARKER_PREFIX)
    ]

    for marker in pt_markers:

        errs = []
        camera_indices = []
        coords_list = []

        if not len(marker.projections.keys()) and not marker.position:
            continue

        # Keep the original working camera-selection logic:
        # marker.position -> camera.project -> central image check
        # -> pickPoint -> world error -> choose minimum error.
        for camera_index, camera in enumerate(chunk.cameras):

            if not marker.position:
                continue

            if not camera.transform:
                continue

            point = marker.position
            coords_2D = camera.project(point)

            if coords_2D is None:
                continue

            x, y = coords_2D

            if (
                camera.sensor.width / 8 <= x < camera.sensor.width / 8 * 7
                and
                camera.sensor.height / 8 <= y < camera.sensor.height / 8 * 7
            ):
                point_internal = chunk.model.pickPoint(
                    camera.center,
                    camera.unproject(coords_2D)
                )

                if point_internal is not None:
                    # reference.location was created from T.mulp(vertex),
                    # so compare against the picked point in the same
                    # transformed/world coordinate system.
                    point3D_world = chunk.transform.matrix.mulp(
                        point_internal
                    )

                    err = marker.reference.location - point3D_world

                    errs.append(err)
                    camera_indices.append(
                        (camera_index, camera.label)
                    )
                    coords_list.append(coords_2D)

        if errs:

            magnitudes = [
                vector_magnitude(err)
                for err in errs
            ]

            error_info = [
                (
                    magnitudes[i],
                    errs[i],
                    camera_indices[i],
                    coords_list[i]
                )
                for i in range(len(magnitudes))
            ]

            error_info.sort(
                key=lambda x: x[0]
            )

            min_error = error_info[0]

            coords_int = (
                int(min_error[3][0]),
                int(min_error[3][1])
            )

            camera_index, camera_label = min_error[2]

            marker_position_chunk_coords = (
                chunk.transform.matrix.mulp(
                    marker.position
                )
            )

            results.append(
                (
                    marker.label,
                    camera_index,
                    camera_label,
                    coords_int,
                    marker_position_chunk_coords,
                    float(min_error[0])
                )
            )

    if not results:
        Metashape.app.messageBox(
            "No suitable camera images were found for the PT markers."
        )
        return

    results_df = pd.DataFrame(
        results,
        columns=[
            "Marker Label",
            "Camera Index",
            "Camera Label",
            "Projected 2D Coordinates",
            "marker_position_chunk_coords",
            "Projection Error"
        ]
    )

    results_df_path = os.path.join(
        output_folder,
        "results_df.txt"
    )

    results_df.to_csv(
        results_df_path,
        index=False,
        header=True
    )

    combined_output_folder_path = os.path.join(
        output_folder,
        "combined_images"
    )

    if export_synthetic:
        os.makedirs(
            combined_output_folder_path,
            exist_ok=True
        )

    for _, row in results_df.iterrows():

        camera_index = row["Camera Index"]
        coords = row["Projected 2D Coordinates"]
        old_x, old_y = coords
        marker_name = row["Marker Label"]

        camera = chunk.cameras[camera_index]

        image_path = camera.photo.path
        image = cv2.imread(image_path)

        if image is None:
            print(
                f"Error loading image: {image_path}. "
                "Skipping this marker."
            )
            continue

        sensor_width = camera.sensor.width
        sensor_height = camera.sensor.height

        # Original orientations + explicit 180° case.
        if camera.orientation == 6:
            new_x, new_y = (
                sensor_height - old_y,
                old_x
            )

        elif camera.orientation == 8:
            new_x, new_y = (
                old_y,
                sensor_width - old_x
            )

        elif camera.orientation == 3:
            new_x, new_y = (
                sensor_width - old_x,
                sensor_height - old_y
            )

        else:
            new_x = old_x
            new_y = old_y

        x_start = max(
            0,
            new_x - crop_size // 2
        )

        y_start = max(
            0,
            new_y - crop_size // 2
        )

        x_end = min(
            image.shape[1],
            new_x + crop_size // 2
        )

        y_end = min(
            image.shape[0],
            new_y + crop_size // 2
        )

        cropped_image = image[
            y_start:y_end,
            x_start:x_end
        ].copy()

        point_x = new_x - x_start
        point_y = new_y - y_start

        if add_red_mark:
            cv2.circle(
                cropped_image,
                (point_x, point_y),
                radius=10,
                color=(0, 0, 255),
                thickness=5
            )

        camera_label = safe_filename(
            camera.label
        )

        filename = (
            f"{marker_name}_{camera_label}_"
            f"x{new_x}_y{new_y}.png"
        )

        output_path = os.path.join(
            output_folder,
            filename
        )

        cv2.imwrite(
            output_path,
            cropped_image
        )

        if not export_synthetic:
            continue

        marker = [
            marker
            for marker in chunk.markers
            if marker.label == marker_name
        ][0]

        if synthetic_view_mode == 1:
            image_np = render_standardized_top_view(
                chunk,
                marker,
                crop_size,
                output_folder
            )

            synthetic_point = (
                image_np.shape[1] // 2,
                image_np.shape[0] // 2
            )

        else:
            image_np, synthetic_point = render_selected_camera_view(
                chunk,
                camera,
                old_x,
                old_y,
                new_x,
                new_y,
                crop_size,
                output_folder
            )

        if add_red_mark:
            cv2.circle(
                image_np,
                synthetic_point,
                radius=10,
                color=(0, 0, 255),
                thickness=-1
            )

        synthetic_view_name = (
            "top"
            if synthetic_view_mode == 1
            else "camera"
        )

        filename = (
            f"{marker_name}_3DModel_"
            f"{synthetic_view_name}_"
            f"{safe_filename(combined_name)}.png"
        )

        output_with_marker_path = os.path.join(
            output_folder,
            filename
        )

        cv2.imwrite(
            output_with_marker_path,
            image_np
        )

        img1 = cropped_image
        img2 = image_np

        if img1.shape[0] != img2.shape[0]:
            img2 = cv2.resize(
                img2,
                (
                    img2.shape[1],
                    img1.shape[0]
                )
            )

        black_line = np.zeros(
            (
                img1.shape[0],
                5,
                3
            ),
            dtype=np.uint8
        )

        combined_image = np.hstack(
            (
                img1,
                black_line,
                img2
            )
        )

        combined_filename = (
            f"{marker.label}_{camera_label}_"
            f"{synthetic_view_name}_"
            f"{safe_filename(combined_name)}.png"
        )

        combined_output_path = os.path.join(
            combined_output_folder_path,
            combined_filename
        )

        cv2.imwrite(
            combined_output_path,
            combined_image
        )

    Metashape.app.messageBox(
        f"Export complete.\n\n"
        f"Markers exported: {len(results_df)}\n"
        f"Results: {results_df_path}"
    )


def register_menu():

    for menu_path in (
        SAMPLE_MENU_PATH,
        EXPORT_MENU_PATH,
        "benthiFriend/Sample points...",
        "benthiFriend/Export marker images..."
    ):
        try:
            Metashape.app.removeMenuItem(
                menu_path
            )
        except Exception:
            pass

    Metashape.app.addMenuItem(
        SAMPLE_MENU_PATH,
        sample_benthic_points
    )

    Metashape.app.addMenuItem(
        EXPORT_MENU_PATH,
        export_marker_images
    )


register_menu()
