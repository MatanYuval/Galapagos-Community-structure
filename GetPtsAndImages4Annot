import math

import Metashape
import numpy as np
import open3d as o3d


ALPHA = 0.05
POINTS_PER_UNIT_AREA = 10
MENU_PATH = "benthiFriend/Sample points..."


def sample_benthic_points():
    """Create Poisson-distributed markers on the model surface."""

    try:
        chunk = Metashape.app.document.chunk

        if chunk is None or chunk.model is None:
            raise RuntimeError("The active chunk has no 3D model.")

        T = chunk.transform.matrix
        origin = T.mulp(Metashape.Vector([0, 0, 0]))

        local_frame = (
            chunk.crs.localframe(origin)
            if chunk.crs
            else Metashape.Matrix().Diag([1, 1, 1, 1])
        )

        m = local_frame * T
        scale = math.sqrt(sum(m[0, i] ** 2 for i in range(3)))

        if scale == 0:
            raise RuntimeError("The chunk transformation has zero scale.")

        rotation = Metashape.Matrix([
            [m[row, column] / scale for column in range(3)]
            for row in range(3)
        ])

        region = chunk.region
        region.rot = rotation.t()
        chunk.region = region

        center = T.mulp(region.center)
        half_size = chunk.transform.scale * region.size / 2

        min_bounds = np.asarray(center - half_size)
        max_bounds = np.asarray(center + half_size)

        vertices = []

        for vertex in chunk.model.vertices:
            position = np.asarray(
                T.mulp(vertex.coord[:3])[:3]
            )

            if np.all(
                (position >= min_bounds)
                & (position <= max_bounds)
            ):
                vertices.append(position)

        if len(vertices) < 4:
            raise RuntimeError(
                "Not enough model vertices were found inside the region."
            )

        vertices = np.asarray(vertices, dtype=np.float64)

        point_cloud = o3d.geometry.PointCloud()
        point_cloud.points = o3d.utility.Vector3dVector(vertices)

        mesh = o3d.geometry.TriangleMesh.create_from_point_cloud_alpha_shape(
            point_cloud,
            ALPHA
        )

        if len(mesh.triangles) == 0:
            raise RuntimeError(
                "The alpha-shape mesh is empty. "
                "Try changing the ALPHA value."
            )

        # Density is based on the original Metashape mesh. The alpha-shape
        # mesh is used only as the surface from which points are sampled.
        surface_area = chunk.model.area()

        suggested_points = max(
            1,
            round(surface_area * POINTS_PER_UNIT_AREA)
        )

        print(f"Original mesh surface area: {surface_area:.3f}")
        print(
            f"Suggested points: {suggested_points} "
            f"({POINTS_PER_UNIT_AREA} points per unit²)"
        )

        number_of_points = Metashape.app.getInt(
            (
                f"Original mesh surface area: {surface_area:.2f} unit²\n"
                f"Suggested density: {POINTS_PER_UNIT_AREA} points/unit²\n"
                "Number of points to sample:"
            ),
            suggested_points
        )

        if number_of_points is None:
            return

        if number_of_points < 1:
            raise ValueError(
                "The number of points must be greater than zero."
            )

        sampled_cloud = mesh.sample_points_poisson_disk(
            number_of_points=number_of_points,
            init_factor=5
        )

        for index, point in enumerate(
            sampled_cloud.points,
            start=1
        ):
            marker = chunk.addMarker()
            marker.reference.location = Metashape.Vector(point)
            marker.label = f"PTxt{index}"

            if index % 500 == 0:
                print(
                    f"Created {index}/{number_of_points} markers"
                )

        Metashape.app.update()

        Metashape.app.messageBox(
            f"Original mesh surface area: {surface_area:.2f} unit²\n"
            f"Created {number_of_points} sampling points."
        )

    except Exception as error:
        Metashape.app.messageBox(
            f"Could not create sampling points:\n\n{error}"
        )
        raise


def register_menu():
    try:
        Metashape.app.removeMenuItem(MENU_PATH)
    except Exception:
        pass

    Metashape.app.addMenuItem(
        MENU_PATH,
        sample_benthic_points
    )

    print(f"Menu registered: {MENU_PATH}")


register_menu()
